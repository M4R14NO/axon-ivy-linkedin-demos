{
  "$schema" : "https://json-schema.axonivy.com/form/12.0.6/form.json",
  "id" : "9eda147a-1f1c-42df-99a8-e5e4e51e3aef",
  "components" : [ {
    "cid" : "composite1",
    "type" : "Composite",
    "config" : {
      "name" : "financial.tracker.part3.DialogView",
      "startMethod" : "start",
      "parameters" : {
        "view" : "PersonDialogWrapper",
        "data" : "#{data.person}",
        "update" : "@form"
      }
    }
  }, {
    "cid" : "layout3",
    "type" : "Layout",
    "config" : {
      "components" : [ {
        "cid" : "button4",
        "type" : "Button",
        "config" : {
          "name" : "Cancel",
          "action" : "#{ivyWorkflowView.cancel()}",
          "variant" : "SECONDARY",
          "style" : "FLAT",
          "processOnlySelf" : true
        }
      }, {
        "cid" : "button5",
        "type" : "Button",
        "config" : {
          "name" : "Proceed",
          "action" : "#{logic.close}",
          "type" : "SUBMIT",
          "icon" : "si si-check-1"
        }
      } ],
      "type" : "FLEX",
      "justifyContent" : "END"
    }
  }, {
    "cid" : "datatable6",
    "type" : "DataTable",
    "config" : {
      "components" : [ {
        "cid" : "datatablecolumn7",
        "type" : "DataTableColumn",
        "config" : {
          "header" : "children",
          "value" : "children"
        }
      }, {
        "cid" : "datatablecolumn8",
        "type" : "DataTableColumn",
        "config" : {
          "header" : "firstName",
          "value" : "firstName"
        }
      }, {
        "cid" : "datatablecolumn9",
        "type" : "DataTableColumn",
        "config" : {
          "header" : "lastName",
          "value" : "lastName"
        }
      }, {
        "cid" : "datatablecolumn11",
        "type" : "DataTableColumn",
        "config" : {
          "header" : "Actions",
          "components" : [ {
            "cid" : "button12",
            "type" : "Button",
            "config" : {
              "action" : "editRow",
              "type" : "EDIT",
              "icon" : "pi pi-pencil"
            }
          }, {
            "cid" : "button13",
            "type" : "Button",
            "config" : {
              "action" : "deleteRow",
              "variant" : "DANGER",
              "type" : "DELETE",
              "icon" : "pi pi-trash",
              "confirmDialog" : true,
              "confirmHeader" : "Delete Confirmation",
              "confirmMessage" : "Are you sure you want to delete row: #{row}?",
              "confirmOkValue" : "Yes",
              "confirmCancelValue" : "No"
            }
          }, {
            "cid" : "button19",
            "type" : "Button",
            "config" : {
              "name" : "Edit Person Button",
              "action" : "#{logic.editPersonActionButton(row)}"
            }
          } ],
          "asActionColumn" : true
        }
      } ],
      "value" : "#{data.popupTest.persons}",
      "maxRows" : "10",
      "isEditable" : true,
      "editDialogId" : "dialog10",
      "addButton" : true
    }
  }, {
    "cid" : "dialog10",
    "type" : "Dialog",
    "config" : {
      "components" : [ {
        "cid" : "datatable14",
        "type" : "DataTable",
        "config" : {
          "id" : "rowTable",
          "components" : [ {
            "cid" : "datatablecolumn17",
            "type" : "DataTableColumn",
            "config" : {
              "header" : "kindAlter",
              "value" : "kindAlter"
            }
          }, {
            "cid" : "datatablecolumn18",
            "type" : "DataTableColumn",
            "config" : {
              "header" : "kindName",
              "value" : "kindName"
            }
          } ],
          "value" : "#{currentRow.children}",
          "maxRows" : "10"
        }
      }, {
        "cid" : "input15",
        "type" : "Input",
        "config" : {
          "label" : "First Name",
          "value" : "#{currentRow.firstName}"
        }
      }, {
        "cid" : "input16",
        "type" : "Input",
        "config" : {
          "label" : "Last Name",
          "value" : "#{currentRow.lastName}"
        }
      } ],
      "header" : "Edit Row",
      "linkedComponent" : "datatable6"
    }
  } ]
}