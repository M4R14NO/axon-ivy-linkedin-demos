{
  "$schema" : "https://json-schema.axonivy.com/form/12.0.6/form.json",
  "id" : "5dd51732-332e-4525-b7a1-8d4c7e2fac3c",
  "components" : [ {
    "cid" : "composite1",
    "type" : "Composite",
    "config" : {
      "id" : "audiorec",
      "name" : "financial.tracker.part3.AudioRecording",
      "startMethod" : "start",
      "parameters" : {
        "audioBytes" : "#{data.audioBytes}",
        "audioReady" : "#{data.audioReady}"
      }
    }
  }, {
    "cid" : "fieldset7",
    "type" : "Fieldset",
    "config" : {
      "components" : [ {
        "cid" : "layout8",
        "type" : "Layout",
        "config" : {
          "components" : [ {
            "cid" : "button9",
            "type" : "Button",
            "config" : {
              "name" : "ASR (with german query param)",
              "action" : "#{logic.restAsrDe}"
            }
          }, {
            "cid" : "button5",
            "type" : "Button",
            "config" : {
              "id" : "transcribeButton",
              "name" : "ASR (without language query param)",
              "action" : "#{logic.transcribe}",
              "icon" : "si si-chat-translate"
            }
          } ]
        }
      }, {
        "cid" : "textarea6",
        "type" : "Textarea",
        "config" : {
          "label" : "ASR Result",
          "value" : "#{data.asrResult}",
          "rows" : "5"
        }
      } ],
      "legend" : "Automatic Speech Recognition",
      "collapsible" : true
    }
  }, {
    "cid" : "layout2",
    "type" : "Layout",
    "config" : {
      "components" : [ {
        "cid" : "button3",
        "type" : "Button",
        "config" : {
          "name" : "Cancel",
          "action" : "#{ivyWorkflowView.cancel()}",
          "variant" : "SECONDARY",
          "style" : "FLAT",
          "processOnlySelf" : true
        }
      }, {
        "cid" : "button4",
        "type" : "Button",
        "config" : {
          "name" : "Proceed",
          "action" : "#{logic.close}",
          "type" : "SUBMIT",
          "icon" : "si si-check-1"
        }
      } ],
      "type" : "FLEX",
      "justifyContent" : "END"
    }
  } ]
}